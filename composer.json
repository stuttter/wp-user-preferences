{
  "name": "stuttter/wp-user-preferences",
  "description": "Prefer personal user settings over site and network settings",
  "homepage": "https://github.com/stuttter/wp-user-preferences",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "John James Jacoby",
      "email": "johnjamesjacoby@me.com"
    }
  ],
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  }
}
